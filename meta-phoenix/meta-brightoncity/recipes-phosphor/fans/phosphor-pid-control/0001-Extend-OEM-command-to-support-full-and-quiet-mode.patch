     bool failSafe() const override;
 
@@ -93,7 +93,7 @@ class DbusPidZone : public ZoneInterface, public ModeObject
 
     const int64_t _zoneId;
     double _maximumSetPoint = 0;
-    bool _manualMode = false;
+    uint8_t _manualMode = 0;
     const double _minThermalOutputSetPt;
     const double _failSafePercent;
 
diff --git a/pid/zone_interface.hpp b/pid/zone_interface.hpp
old mode 100644
new mode 100755
index a024c0e..f30a2fe
--- a/pid/zone_interface.hpp
+++ b/pid/zone_interface.hpp
@@ -74,7 +74,7 @@ class ZoneInterface
     /** Return if the zone is set to manual mode.  false equates to automatic
