@@ -447,7 +447,7 @@ Sensor* DbusPidZone::getSensor(const std::string& name)
     return _mgr.getSensor(name);
 }
 
-bool DbusPidZone::manual(bool value)
+uint8_t DbusPidZone::manual(uint8_t value)
 {
     std::cerr << "manual: " << value << std::endl;
     setManualMode(value);
