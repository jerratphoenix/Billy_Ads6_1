From b040c48bd0535dce27035e63dcdb542f5204150f Mon Sep 17 00:00:00 2001
From: Chris Yeh <chris_yeh@phoenix.com>
Date: Thu, 18 Nov 2021 14:41:10 +0800
Subject: [PATCH] Add resetreason to kernel cmdline

---
 arch/arm/include/asm/arch-aspeed/ast_scu.h |  2 +-
 arch/arm/mach-aspeed/ast-scu.c             | 29 +++++--
 board/aspeed/ast-g5/ast-g5-intel.c         | 90 +++++++++++++---------
 3 files changed, 78 insertions(+), 43 deletions(-)

diff --git a/arch/arm/include/asm/arch-aspeed/ast_scu.h b/arch/arm/include/asm/arch-aspeed/ast_scu.h
index b94d13e97d..99167c2ea5 100755
--- a/arch/arm/include/asm/arch-aspeed/ast_scu.h
+++ b/arch/arm/include/asm/arch-aspeed/ast_scu.h
@@ -31,7 +31,7 @@
 #include <common.h>
 
 extern void ast_scu_show_system_info (void);
-extern void ast_scu_sys_rest_info(void);
+extern u32 ast_scu_sys_rest_info(void);
 extern void ast_scu_security_info(void);
 extern u32 ast_scu_revision_id(void);
 extern u32 ast_scu_get_vga_memsize(void);
diff --git a/arch/arm/mach-aspeed/ast-scu.c b/arch/arm/mach-aspeed/ast-scu.c
index ff90c0fc7e..3f789d5a1f 100755
--- a/arch/arm/mach-aspeed/ast-scu.c
+++ b/arch/arm/mach-aspeed/ast-scu.c
@@ -593,7 +593,7 @@ void ast_scu_security_info(void)
 	}
 }
 
-void ast_scu_sys_rest_info(void)
+u32 ast_scu_sys_rest_info(void)
 {
 	u32 rest = ast_scu_read(AST_SCU_SYS_CTRL);
 	bool unknown_flag = true;
@@ -602,35 +602,50 @@ void ast_scu_sys_rest_info(void)
 	printf("RST : 0x%02x (", rest);
 	if (rest & SCU_SYS_EXT_RESET_FLAG) {
 		unknown_flag = false;
+		ast_scu_write(SCU_SYS_EXT_RESET_FLAG, AST_SCU_SYS_CTRL);
+		rest = SCU_SYS_EXT_RESET_FLAG;
 		printf("External");
 	}
 	if (rest & SCU_SYS_WDT_RESET_FLAG) {
-		if (unknown_flag)
+		if (unknown_flag){
 			printf("WDT1");
+			ast_scu_write(SCU_SYS_WDT_RESET_FLAG, AST_SCU_SYS_CTRL);
+			rest = SCU_SYS_WDT_RESET_FLAG;
+		}
 		else
 			printf("|WDT1");
 		unknown_flag = false;
 	}
 	if (rest & SCU_SYS_WDT2_RESET_FLAG) {
-		if (unknown_flag)
+		if (unknown_flag){
 			printf("WDT2");
+			ast_scu_write(SCU_SYS_WDT2_RESET_FLAG, AST_SCU_SYS_CTRL);
+			rest = SCU_SYS_WDT2_RESET_FLAG;
+		}
 		else
 			printf("|WDT2");
 		unknown_flag = false;
 	}
 	if (rest & SCU_SYS_WDT3_RESET_FLAG) {
-		if (unknown_flag)
+		if (unknown_flag){
 			printf("WDT3");
+			ast_scu_write(SCU_SYS_WDT3_RESET_FLAG, AST_SCU_SYS_CTRL);
+			rest = SCU_SYS_WDT3_RESET_FLAG;
+		}
 		else
 			printf("|WDT3");
 		unknown_flag = false;
 	}
 	if (rest & SCU_SYS_PWR_RESET_FLAG) {
-		if (unknown_flag)
+		if (unknown_flag){
 			printf("Power On");
+			ast_scu_write(SCU_SYS_PWR_RESET_FLAG, AST_SCU_SYS_CTRL);
+			rest = SCU_SYS_PWR_RESET_FLAG;
+		}
 		else
 			printf("|Power On");
 		unknown_flag = false;
+
 	}
 	if (unknown_flag) {
 		printf("Unknown");
@@ -640,16 +655,20 @@ void ast_scu_sys_rest_info(void)
 	if (rest & SCU_SYS_EXT_RESET_FLAG) {
 		printf("RST : External\n");
 		ast_scu_write(SCU_SYS_EXT_RESET_FLAG, AST_SCU_SYS_CTRL);
+		rest = SCU_SYS_EXT_RESET_FLAG;
 	} else if (rest & SCU_SYS_WDT_RESET_FLAG) {
 		printf("RST : Watchdog\n");
 		ast_scu_write(SCU_SYS_WDT_RESET_FLAG, AST_SCU_SYS_CTRL);
+		rest = SCU_SYS_WDT_RESET_FLAG;
 	} else if (rest & SCU_SYS_PWR_RESET_FLAG) {
 		printf("RST : Power On\n");
 		ast_scu_write(SCU_SYS_PWR_RESET_FLAG, AST_SCU_SYS_CTRL);
+		rest = SCU_SYS_PWR_RESET_FLAG;
 	} else {
 		printf("RST : CLK en\n");
 	}
 #endif
+	return rest;
 }
 
 u32 ast_scu_get_vga_memsize(void)
diff --git a/board/aspeed/ast-g5/ast-g5-intel.c b/board/aspeed/ast-g5/ast-g5-intel.c
index 3b5949b357..edaec695dc 100755
--- a/board/aspeed/ast-g5/ast-g5-intel.c
+++ b/board/aspeed/ast-g5/ast-g5-intel.c
@@ -12,6 +12,7 @@
 #include <asm/arch/regs-scu.h>
 #include <asm/arch/ast_scu.h>
 #include <asm/arch/aspeed.h>
+#include <stdlib.h>
 
 #include "ast-g5.h"
 #include "ast-g5-gpio.h"
@@ -474,60 +475,66 @@ static void set_pwm_duty_cycle(int duty)
 
 }
 
-
 static void update_bootargs_cmd(const char *key, const char *value)
 {
 	int buf_len;
 	char *buf;
 	char *cmdline;
-	char comp_key[128];
+	char *end = NULL;
 
 	if (!key || (key[0] == '\0')) {
-		printf("%s - Empty key not allowed\n", __func__);
+		printf("%s: Empty key not allowed\n", __func__);
 		return;
 	}
 
 	cmdline = getenv("bootargs");
 
 	/* Allocate space for maximum possible new command line */
-	if (value)
-		buf_len = strlen(cmdline) + strlen(key) + 3 + strlen(value);
-	else
-		buf_len = strlen(cmdline) + strlen(key) + 3;
+	buf_len = (cmdline ? strlen(cmdline) : 0)
+		+ 1 /* spacebar as delimiter */
+		+ strlen(key)
+		+ (value ? 1 /* equal sign */ + strlen(value) : 0)
+		+ 1 /* terminating null */;
 
-	buf = malloc(buf_len);
+	buf = calloc(buf_len, sizeof(char));
 	if (!buf) {
 		printf("%s: out of memory\n", __func__);
 		return;
 	}
-	memset(buf, 0, buf_len);
 
-	if (!cmdline) {
-		/* lets add key-value, though bootargs are empty */
-		snprintf(buf, buf_len, "%s=%s", key, (value ? value : ""));
-		setenv("bootargs", buf);
-		free(buf);
-		return;
+	if (cmdline)
+	{
+		char *start = strstr(cmdline, key);
+
+		/* Check for full word match. Match should be start of cmdline
+		 * or there should be space before match
+		 **/
+		if (start && ((start == cmdline) || (*(start - 1) == ' '))) {
+			strncat(buf, cmdline, (start - cmdline));
+
+			/* Find the end of the keyword[=value] pair,
+			 * including a single training space character, if any.
+			 * Skip the found substring, mark the tail of cmdline.
+			 **/
+			end = strchr(start, ' ');
+			if (end) {
+				end++;
+			}
+		} else {
+			strcat(buf, cmdline);
+			strcat(buf, " ");
+		}
 	}
 
-	snprintf(comp_key, sizeof(comp_key), "%s=", key);
-	char *start = strstr(cmdline, comp_key);
-
-	/* Check for full word match. Match should be start of cmdline
-	 * or there should be space before match */
-	if (start && ((start == cmdline) || (*(start-1) == ' '))) {
-		char *end = strchr(start, ' ');
-		strncpy(buf, cmdline, (start - cmdline));
-
-		if (end)
-			snprintf(buf, buf_len, "%s%s=%s %s", buf, key,
-				 (value ? value : ""), end+1);
-		else
-			snprintf(buf, buf_len, "%s%s=%s", buf, key,
-				 (value ? value : ""));
-	} else {
-		snprintf(buf, buf_len, "%s %s=%s", cmdline, key,
-			 (value ? value : ""));
+	strcat(buf, key);
+	if (value) {
+		strcat(buf, "=");
+		strcat(buf, value);
+	}
+
+	if (end) {
+		strcat(buf, " ");
+		strcat(buf, end);
 	}
 
 	setenv("bootargs", buf);
@@ -601,12 +608,20 @@ void ast_g5_intel_late_init(void)
 	}
 
 	/* save and clear reset status */
-	reset_reason = ast_scu_read(AST_SCU_SYS_CTRL);
-	snprintf(value, sizeof(value), "0x%x", reset_reason);
+	reset_reason =  ast_scu_sys_rest_info();
+
+	if (reset_reason & SCU_SYS_EXT_RESET_FLAG) {
+		update_bootargs_cmd("resetreason", "external");
+	} else if (reset_reason & SCU_SYS_WDT_RESET_FLAG) {
+		update_bootargs_cmd("resetreason", "watchdog");
+	} else if (reset_reason & SCU_SYS_PWR_RESET_FLAG) {
+		update_bootargs_cmd("resetreason", "power");
+	} else {
+		snprintf(value, sizeof(value), "0x%x", reset_reason);
+		update_bootargs_cmd("resetreason", value);
+	}
 	ast_scu_write(0, AST_SCU_SYS_CTRL);
 
-	update_bootargs_cmd("resetreason", value);
-
 	boot_failures = get_boot_failures();
 
 	if (reset_reason & WATCHDOG_RESET_BIT)
@@ -619,6 +634,7 @@ void ast_g5_intel_late_init(void)
 		update_bootargs_cmd("special", "mfg");
 	else
 		update_bootargs_cmd("special", NULL);
+
 }
 
 static void uart_init(void)
