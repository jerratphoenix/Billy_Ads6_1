From 4a24033a0d562c8b7cb431f0d206c764ad5575cf Mon Sep 17 00:00:00 2001
From: Kian_Lee <Kian_Lee@phoenix.com>
Date: Wed, 2 Mar 2022 11:19:17 +0800
Subject: [PATCH] Add "xyz.openbmc_project.State.Decorator.OperationalStatus"
 interface and Functional property

---
 include/cpu.hpp | 10 ++++++++--
 src/cpu.cpp     |  9 +++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/include/cpu.hpp b/include/cpu.hpp
index c2edca9..2e7623c 100644
--- a/include/cpu.hpp
+++ b/include/cpu.hpp
@@ -21,6 +21,8 @@
 #include <xyz/openbmc_project/Inventory/Decorator/Revision/server.hpp>
 #include <xyz/openbmc_project/Inventory/Item/Cpu/server.hpp>
 #include <xyz/openbmc_project/Inventory/Item/server.hpp>
+#include <xyz/openbmc_project/State/Decorator/OperationalStatus/server.hpp>
+
 
 namespace phosphor
 {
@@ -34,6 +36,9 @@ using asset =
     sdbusplus::xyz::openbmc_project::Inventory::Decorator::server::Asset;
 using processor = sdbusplus::xyz::openbmc_project::Inventory::Item::server::Cpu;
 using Item = sdbusplus::xyz::openbmc_project::Inventory::server::Item;
+using Functional = sdbusplus::server::object::object<sdbusplus::xyz::openbmc_project::State::
+                                             Decorator::server::OperationalStatus>;
+
 
 // Definition follow smbios spec DSP0134 3.0.0
 static const std::map<uint8_t, const char*> familyTable = {
@@ -90,7 +95,7 @@ static const std::array<std::optional<processor::Capability>, 16>
                          std::nullopt,
                          std::nullopt};
 
-class Cpu : sdbusplus::server::object_t<processor, asset, rev, Item>
+class Cpu : sdbusplus::server::object_t<processor, asset, rev, Item,Functional>
 {
   public:
     Cpu() = delete;
@@ -102,7 +107,7 @@ class Cpu : sdbusplus::server::object_t<processor, asset, rev, Item>
 
     Cpu(sdbusplus::bus::bus& bus, const std::string& objPath,
         const uint8_t& cpuId, uint8_t* smbiosTableStorage) :
-        sdbusplus::server::object_t<processor, asset, rev, Item>(
+        sdbusplus::server::object_t<processor, asset, rev, Item,Functional>(
             bus, objPath.c_str()),
         cpuNum(cpuId), storage(smbiosTableStorage)
     {
@@ -110,6 +115,7 @@ class Cpu : sdbusplus::server::object_t<processor, asset, rev, Item>
     }
 
     void infoUpdate(void);
+    bool functional_property(bool value) ;
 
   private:
     uint8_t cpuNum;
diff --git a/src/cpu.cpp b/src/cpu.cpp
index 9eb90f4..d6189a4 100644
--- a/src/cpu.cpp
+++ b/src/cpu.cpp
@@ -32,6 +32,13 @@ void Cpu::socket(const uint8_t positionNum, const uint8_t structLen,
     processor::socket(result);
 }
 
+bool Cpu::functional_property(bool value)
+{
+    return sdbusplus::xyz::openbmc_project::State::Decorator::server::
+            OperationalStatus::functional(value);
+}
+
+
 void Cpu::family(const uint8_t value)
 {
     std::map<uint8_t, const char*>::const_iterator it = familyTable.find(value);
@@ -117,9 +124,11 @@ void Cpu::infoUpdate(void)
     {
         // Don't attempt to fill in any other details if the CPU is not present.
         present(false);
+        functional_property(false);
         return;
     }
     present(true);
+    functional_property(true);
 
     // this class is for type CPU  //offset 5h
     family(cpuInfo->family); // offset 6h
