 include/sdrutils.hpp   |  16 +-
 src/sensorcommands.cpp | 428 +++++++++++++++++++++++------------------
 2 files changed, 260 insertions(+), 184 deletions(-)
 mode change 100644 => 100755 include/sdrutils.hpp
 mode change 100644 => 100755 src/sensorcommands.cpp

diff --git a/include/sdrutils.hpp b/include/sdrutils.hpp
old mode 100644
new mode 100755
index 697dad3..6907e3d
--- a/include/sdrutils.hpp
+++ b/include/sdrutils.hpp
@@ -356,6 +356,8 @@ enum class SensorTypeCodes : uint8_t
     current = 0x3,
     fan = 0x4,
     other = 0xB,
+    oemdiscrete = 0xC0,
+    oemdiscreteeventonly = 0xC1,
 };
 
 const static boost::container::flat_map<const char*, SensorTypeCodes, CmpStr>
@@ -364,7 +366,9 @@ const static boost::container::flat_map<const char*, SensorTypeCodes, CmpStr>
                  {"current", SensorTypeCodes::current},
                  {"fan_tach", SensorTypeCodes::fan},
                  {"fan_pwm", SensorTypeCodes::fan},
-                 {"power", SensorTypeCodes::other}}};
+                 {"power", SensorTypeCodes::other},
+                 {"oemdiscrete", SensorTypeCodes::oemdiscrete},
+                 {"oemdiscreteeventonly", SensorTypeCodes::oemdiscreteeventonly}}};
 
 inline static std::string getSensorTypeStringFromPath(const std::string& path)
 {
@@ -420,7 +424,17 @@ inline static uint16_t getSensorNumberFromPath(const std::string& path)
 
 inline static uint8_t getSensorEventTypeFromPath(const std::string& path)
 {
+    uint8_t u8SensorType;
+
+    u8SensorType = getSensorTypeFromPath(path);
+
     // TODO: Add support for additional reading types as needed
+    if((static_cast<uint8_t>(SensorTypeCodes::oemdiscrete) == u8SensorType) ||
+       (static_cast<uint8_t>(SensorTypeCodes::oemdiscreteeventonly) == u8SensorType))
+    {
+        return 0x70;	// reading type = oem discrete
+    }
+
     return 0x1; // reading type = threshold
 }
 
