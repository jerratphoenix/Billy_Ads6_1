+#pragma once
+#include <sel_logger.hpp>
+#include <sensorutils.hpp>
+#include <string_view>
+#include <variant>
+#include <string>
+
+// static const std::string openBMCMessageRegistryVersion("0.1");
+
+inline static sdbusplus::bus::match::match startDiscreteEventMonitor(
+    std::shared_ptr<sdbusplus::asio::connection> conn)
+{
+    auto discreteEventMatcherCallback = [conn](
+                                             sdbusplus::message::message &msg) {
+        // This static set of std::pair<path, event> tracks asserted events to
+        // avoid duplicate logs or deasserts logged without an assert
+        static boost::container::flat_set<std::pair<std::string, std::string>>
+            assertedEvents;
+        // SEL event data is three bytes where 0xFF means unspecified
+        std::vector<uint8_t> eventData(selEvtDataMaxSize, 0xFF);
+
+        // Get the event type and assertion details from the message
+        std::string thresholdInterface;
+        boost::container::flat_map<std::string, std::variant<unsigned int>> propertiesChanged;
+
+        msg.read(thresholdInterface, propertiesChanged);
+        std::string event = propertiesChanged.begin()->first;
+
+        unsigned int *pval = std::get_if<unsigned int>(&propertiesChanged.begin()->second);
+        if (!pval)
+        {
+            std::cerr << "discrete offset has an invalid type\n";
+            return;
+        }
+
+        unsigned int offset = *pval;
+        bool assert = false;
+
+        // Ignore events with invalid offsets (which occur at init time when properties are created)
+        if ( offset > 14 )
+        {
+            return;
+        }
+
+        // Determine if it was an assertion or deassertion by the event name
+        if (event == "AssertionAlarmOffset")
+        {
+            assert = true;
+
+        }
+
+        // Grab the offset
+        eventData[0] = static_cast<uint8_t>(offset);
+        
+        // Indicate that bytes 2 and 3 undefined
+        eventData[1] = 0xFF;
+        eventData[2] = 0xFF;
+
+        // Construct a human-readable message of this event for the log
+        std::string_view sensorName(msg.get_path());
+        sensorName.remove_prefix(
+            std::min(sensorName.find_last_of("/") + 1, sensorName.size()));
+
+        std::string direction;
+        std::string redfishMessageID =
+            "OpenBMC." + openBMCMessageRegistryVersion;
+        if (assert)
+        {
+            direction = "asserted";
+            redfishMessageID += ".DiscreteSensorAsserted";
+        }
+        else
+        {
+            direction = "deasserted";
+            redfishMessageID += ".DiscreteSensorDeasserted";
+        }
+
+        std::string journalMsg(std::string(sensorName) + " sensor " +
+                               direction + " offset " + std::to_string(offset) + ".");
+
+        selAddSystemRecord(
+            journalMsg, std::string(msg.get_path()), eventData, assert,
+            selBMCGenID, "REDFISH_MESSAGE_ID=%s", redfishMessageID.c_str(),
+            "REDFISH_MESSAGE_ARGS=%.*s,%u", sensorName.length(),
+            sensorName.data(), offset);
+    };
+    sdbusplus::bus::match::match discreteEventMatcher(
+        static_cast<sdbusplus::bus::bus &>(*conn),
+        "type='signal',interface='org.freedesktop.DBus.Properties',member='"
+        "PropertiesChanged',arg0namespace='xyz.openbmc_project.Sensor."
+        "Discrete.Event'",
+        std::move(discreteEventMatcherCallback));
+    return discreteEventMatcher;
+}
