diff --git a/include/discrete_event_monitor.hpp b/include/discrete_event_monitor.hpp
new file mode 100755
index 0000000..3ec3e77
--- /dev/null
+++ b/include/discrete_event_monitor.hpp
@@ -0,0 +1,110 @@
