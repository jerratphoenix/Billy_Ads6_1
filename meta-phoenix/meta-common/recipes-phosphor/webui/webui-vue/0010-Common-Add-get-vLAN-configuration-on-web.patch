   },
   actions: {
     async getEthernetData({ commit }) {
@@ -68,6 +78,35 @@ const NetworkStore = {
         });
     },
 
+    async getvLANs({ commit }) {
+      return await api
+        .get('/redfish/v1/Managers/bmc/EthernetInterfaces/eth0/VLANs')
+        .then((response) =>
+          response.data.Members.map(
+            (vlanInterface) => vlanInterface['@odata.id']
+          )
+        )
+        .then((vlanInterfaceIds) =>
+          api.all(
+            vlanInterfaceIds.map((vlanInterface) => api.get(vlanInterface))
+          )
+        )
+        .then((vlanInterfaces) => {
+          const vlanethernetData = vlanInterfaces.map(
+            (vlanInterface) => vlanInterface.data
+          );
+          const vlaninterfaceOptions = vlanInterfaces.map(
+            (vlanName) => vlanName.data.Id
+          );
+          const vlanEnable = vlanInterfaces.map(
+            (vlanName) => vlanName.data.VLANEnable
+          );
+          commit('setvlanEthernetData', vlanethernetData);
+          commit('setvLANId', vlaninterfaceOptions);
+          commit('setvLANEnable', vlanEnable);
+        });
+    },
+
