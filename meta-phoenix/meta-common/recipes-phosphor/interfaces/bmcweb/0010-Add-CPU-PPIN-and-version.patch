Subject: [PATCH] Add CPU PPIN and version.

---
 redfish-core/lib/processor.hpp | 10 ++++++++++
 1 file changed, 10 insertions(+)
 mode change 100644 => 100755 redfish-core/lib/processor.hpp

diff --git a/redfish-core/lib/processor.hpp b/redfish-core/lib/processor.hpp
old mode 100644
new mode 100755
index d976264..bb77a32
--- a/redfish-core/lib/processor.hpp
+++ b/redfish-core/lib/processor.hpp
@@ -180,6 +180,16 @@ inline void
                         boost::lexical_cast<std::string>(*value);
                 }
             }
+            else if (property.first == "PPIN")
+            {
+                const std::string* value =
+                    std::get_if<std::string>(&property.second);
+                if (value != nullptr)
+                {
+                    aResp->res.jsonValue["ProtectedIdentificationNumber"] =
+                        *value;
+                }
+            }
         }
     }
 
