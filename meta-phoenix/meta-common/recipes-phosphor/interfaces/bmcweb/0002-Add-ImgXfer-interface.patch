+#pragma once
+
+#include <boost/container/flat_map.hpp>
+#include <error_messages.hpp>
+#include <registries/privilege_registry.hpp>
+#include <variant>
+
+namespace redfish
+{
+
+inline void requestRoutesImgXfer(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/ImgXfer/")
+        .privileges(redfish::privileges::getImgXfer)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                asyncResp->res.jsonValue = {
+                    {"@odata.id", "/redfish/v1/ImgXfer"},
+                    {"@odata.type", "#ImgXfer.v1_0_0."
+                                    "ImgXfer"},
+                    {"Id", "ImgXfer"},
+                    {"Name", "ImgXfer Service"},
+                    {"Description", "Service for Host Image Transfer"},
+                    {"ServiceEnabled", true},
+                    {"Inventory",
+                    {{"@odata.id", "/redfish/v1/ImgXfer/Inventory"}}},
+                };
+                asyncResp->res.end();
+                });
+
+    BMCWEB_ROUTE(app, "/redfish/v1/ImgXfer/Inventory")
+        .privileges(redfish::privileges::getImgXferInventoryCollection)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                asyncResp->res.jsonValue = {
+                    {"@odata.id", "/redfish/v1/ImgXfer/Inventory"},
+                    {"@odata.type", "#ImgXferInventoryCollection."
+                                    "ImgXferInventoryCollection"},
+                    {"Name", "Host Transfer Inventory Collection"},
+                    {"Members", nlohmann::json::array()}, //Test value
+                    {"Members@odata.count", 0}, //Test value
+                };
+
+                nlohmann::json& members = asyncResp->res.jsonValue["Members"];
+
+                members.push_back({{"@odata.id", "/redfish/v1/ImgXfer/Inventory/UEFIFW"}});
+                asyncResp->res.jsonValue["Members@odata.count"] = members.size();
+
+                members.push_back({{"@odata.id", "/redfish/v1/ImgXfer/Inventory/UEFISettings"}});
+                asyncResp->res.jsonValue["Members@odata.count"] = members.size();
+
+                asyncResp->res.end();
+                }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/ImgXfer/Inventory/<str>")
+        .privileges(redfish::privileges::getImgXferInventory)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp, 
+                const std::string& params)-> void{
+                if (params.size() != 1)
+                {
+                    messages::internalError(asyncResp->res);
+                    asyncResp->res.end();
+                    return;
+                }
+
+                std::string swId = params;
+
+                // If the swID ends in .bin then it is being downloaded
+                if( ("UEFIFW.bin" == swId) || ("UEFISettings.bin" == swId) )
+                {
+                    std::string swId = params;
+
+                    std::string strFilename( "/tmp/" + swId );
+
+                    BMCWEB_LOG_DEBUG << "Reading file from " << strFilename;
+
+                    if( ! std::filesystem::exists(strFilename) )
+                    {
+                        BMCWEB_LOG_ERROR << strFilename << "Not found";
+                        asyncResp->res.result(boost::beast::http::status::not_found);
+                        asyncResp->res.jsonValue["Description"] = "Resource Not Found";
+                        asyncResp->res.end();
+                        return;
+                    }
+
+                    std::ifstream hReadFile(strFilename.c_str(), std::ifstream::in | std::ifstream::binary);
+                    if( ! hReadFile )
+                    {
+                        BMCWEB_LOG_ERROR << strFilename << "Not found";
+                        asyncResp->res.result(boost::beast::http::status::not_found);
+                        asyncResp->res.jsonValue["Description"] = "Resource Not Found";
+                        asyncResp->res.end();
+                        return;
+                    }
+
+                    // Tell the client it will be receiving an attachment
+                    std::string contentDispositionParam = "attachment; filename=\"" + swId + "\"";
+                    asyncResp->res.addHeader("Content-Disposition", contentDispositionParam);
+
+                    std::string strFileData;
+
+                    hReadFile.seekg( 0, std::ios::end );
+                    strFileData.reserve( static_cast<unsigned int>(hReadFile.tellg()) );
+                    hReadFile.seekg( 0, std::ios::beg );
+
+                    strFileData.assign( (std::istreambuf_iterator<char>(hReadFile)), std::istreambuf_iterator<char>() );
+
+                    asyncResp->res.body() = std::move(strFileData);
+
+                    asyncResp->res.end();
+                }
+                else
+                {
+                    // Check if this parameter is in the allowed list
+                    if( ("UEFIFW" == swId) || ("UEFISettings" == swId) )
+                    {
+                        asyncResp->res.jsonValue = {
+                            {"@odata.id", "/redfish/v1/ImgXfer/Inventory/" + swId},
+                            {"@odata.type", "#ImgXferInventory.v1_0_0."
+                                            "ImgXferInventory"},
+                            {"Id", swId},
+                            {"Name", "ImgXfer Service"},
+                            {"Description", swId + " image"},
+                            {"Present", false},
+                        };
+
+                        std::string strFilename( "/tmp/" + swId + ".bin" );
+                        if( std::filesystem::exists(strFilename) )
+                        {
+                            std::ifstream hReadFile(strFilename.c_str(), std::ifstream::in | std::ifstream::binary);
+                            if( ! hReadFile )
+                            {
+                                BMCWEB_LOG_ERROR << strFilename << "Not found";
+                                asyncResp->res.result(boost::beast::http::status::not_found);
+                                asyncResp->res.jsonValue["Description"] = "Resource Not Found";
+                                asyncResp->res.end();
+                                return;
+                            }
+
+                            hReadFile.seekg( 0, std::ios::end );
+                            asyncResp->res.jsonValue["Size"] = static_cast<unsigned int>(hReadFile.tellg());
+                            hReadFile.seekg( 0, std::ios::beg );
+                            hReadFile.close();
+                            asyncResp->res.jsonValue["Present"] = true;
+                        }
+
+                        nlohmann::json& members = asyncResp->res.jsonValue["RelatedItem"];
+                        members.push_back( {{"@odata.id", "/redfish/v1/Systems/system/Bios"}});
+                    }
+                    else
+                    {
+                        BMCWEB_LOG_ERROR << "Input swID " + swId + " not found!";
+                        messages::resourceMissingAtURI(asyncResp->res, "/redfish/v1/ImgXfer/Inventory/" + swId);
+                    }
+
+                    asyncResp->res.end();
+                }
+
+
+            }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/ImgXfer/Inventory/<str>")
+        .privileges(redfish::privileges::postImgXferInventory)
+        .methods(boost::beast::http::verb::post)( 
+            [](const crow::Request& req, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+                const std::string& params)-> void{
+                    BMCWEB_LOG_DEBUG << "doPost...";
+
+                    if (params.size() != 1)
+                    {
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+
+                    std::string swId = params;
+
+                    if( ("UEFIFW" == swId) || ("UEFISettings" == swId) )
+                    {
+                        std::string strFilename( "/tmp/" + swId + ".bin" );
+                        BMCWEB_LOG_DEBUG << "Writing file to " << strFilename;
+                        std::ofstream hWrite(strFilename, std::ofstream::out | std::ofstream::binary | std::ofstream::trunc);
+                        hWrite << req.body;
+
+                        // Get the file size after writing
+			            hWrite.seekp( 0, std::ios::end );
+                        asyncResp->res.jsonValue["Size"] = static_cast<unsigned int>(hWrite.tellp());
+                        hWrite.seekp( 0, std::ios::beg );
+
+                        hWrite.close();
+
+                        asyncResp->res.jsonValue["Status"] = "Complete";
+                    }
+                    else
+                    {
+                        BMCWEB_LOG_ERROR << "Input swID " + swId + " not found!";
+                        messages::resourceMissingAtURI(asyncResp->res, "/redfish/v1/ImgXfer/Inventory/" + swId);
+                    }
+
+                    asyncResp->res.end();
+                }
+        );
+    
+    BMCWEB_ROUTE(app, "/redfish/v1/ImgXfer/Inventory/<str>")
+        .privileges(redfish::privileges::deleteImgXferInventory)
+        .methods(boost::beast::http::verb::delete_)(
+            [](const crow::Request& /* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp, 
+                const std::string& params)-> void{
+                    BMCWEB_LOG_DEBUG << "doDelete...";
+
+                    if (params.size() != 1)
+                    {
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+
+                    std::string swId = params;
+
+                    if( ("UEFIFW" == swId) || ("UEFISettings" == swId) )
+                    {
+                        std::string strFilename( "/tmp/" + swId + ".bin" );
+                        BMCWEB_LOG_DEBUG << "Deleting file " << strFilename;
+
+                        std::filesystem::remove(strFilename);
+
+                        asyncResp->res.jsonValue["Status"] = "Complete";
+                    }
+                    else
+                    {
+                        BMCWEB_LOG_ERROR << "Input swID " + swId + " not found!";
+                        messages::resourceMissingAtURI(asyncResp->res, "/redfish/v1/ImgXfer/Inventory/" + swId);
+                    }
+
+                    asyncResp->res.end();
+                }
+        );
+}
+}// namespace redfish
\ No newline at end of file
