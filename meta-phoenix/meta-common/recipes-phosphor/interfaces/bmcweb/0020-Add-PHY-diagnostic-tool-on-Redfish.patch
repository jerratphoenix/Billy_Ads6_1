 meson_options.txt                             |   1 +
 redfish-core/include/redfish.hpp              |   3 +
 .../include/registries/privilege_registry.hpp |  16 ++
 redfish-core/lib/oem_phy_module.hpp           | 176 ++++++++++++++++++
 5 files changed, 197 insertions(+)
 create mode 100755 redfish-core/lib/oem_phy_module.hpp

