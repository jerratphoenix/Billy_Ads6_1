+const static auto& deleteGPIOSet = privilegeSetConfigureManager;
+const static auto& postGPIOSet = privilegeSetConfigureManager;
+
+//GPIOGet
+const static auto& getGPIOGet = privilegeSetLogin;
+const static auto& headGPIOGet = privilegeSetLogin;
+const static auto& patchGPIOGet = privilegeSetLogin;
+const static auto& putGPIOGet = privilegeSetConfigureManager;
+const static auto& deleteGPIOGet = privilegeSetConfigureManager;
+const static auto& postGPIOGet = privilegeSetConfigureManager;
+
 // HostInterface
 const static auto& getHostInterface = privilegeSetLogin;
 const static auto& headHostInterface = privilegeSetLogin;
diff --git a/redfish-core/lib/oem_gpio_module.hpp b/redfish-core/lib/oem_gpio_module.hpp
new file mode 100755
index 0000000..475c49d
--- /dev/null
+++ b/redfish-core/lib/oem_gpio_module.hpp
@@ -0,0 +1,172 @@
+#pragma once
+
+#include "registries.hpp"
+#include "registries/base_message_registry.hpp"
+#include "registries/openbmc_message_registry.hpp"
+#include "task.hpp"
+
+#include <systemd/sd-journal.h>
+
+#include <boost/algorithm/string/split.hpp>
+#include <boost/beast/core/span.hpp>
+#include <boost/container/flat_map.hpp>
+#include <boost/system/linux_error.hpp>
+#include <error_messages.hpp>
+
+#include <filesystem>
+#include <string_view>
+#include <variant>
+#include <cctype>
+#include <stdlib.h>
+
+namespace redfish
+{
+
+inline void requestRoutesOEMGPIOSet(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/GPIOSet")
+        .privileges(redfish::privileges::getGPIOSet)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    asyncResp->res.jsonValue = {
+                        {"@odata.context", "/redfish/v1/$metadata#Manager"},
+                        {"@odata.id", "/redfish/v1/Managers/bmc/Oem/GPIOSet"},
+                        {"@odata.type", "#OEMGPIOModule.OEMGPIOModule"},
+                        {"Name", "GPIO Set"},
+                        {"Describe", "Use PATCH { CHIP:[number], NUMBER:[number], DATA:[number] } to Set register"},
+                    };
+                    asyncResp->res.end();
+                    return;
+                }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/GPIOSet")
+        .privileges(redfish::privileges::patchGPIOSet)
+        .methods(boost::beast::http::verb::patch)(
+            [](const crow::Request& req , 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    std::optional<uint8_t> chip;
+                    std::optional<uint8_t> number;
+                    std::optional<uint8_t> data;
+                    if (!json_util::readJson(req, asyncResp->res, "CHIP", chip, "NUMBER", number, "DATA", data))
+                    {
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::string chip_set;
+                    std::string number_set;
+                    std::string data_set;
+                    if (chip)
+                    {
+                        // Supported range [0-5]
+                        if (*chip > 5)
+                        {
+                            messages::queryParameterOutOfRange(
+                                asyncResp->res, std::to_string(*chip),
+                                "chip", "[0-5]");
+                        }
+                        else
+                        {
+                            chip_set = std::to_string(*chip);
+                        }
+                    }
+                    number_set = std::to_string(*number);
+                    data_set = std::to_string(*data);
+                    std::string cmd("gpioset " + chip_set + " " + number_set + "=" + data_set);
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write ,error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+
+                    asyncResp->res.end();
+                    return ;
+                }
+        );
+
+}
+
+inline void requestRoutesOEMGPIOGet(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/GPIOGet")
+        .privileges(redfish::privileges::getGPIOGet)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    asyncResp->res.jsonValue = {
+                        {"@odata.context", "/redfish/v1/$metadata#Manager"},
+                        {"@odata.id", "/redfish/v1/Managers/bmc/Oem/GPIOGet"},
+                        {"@odata.type", "#OEMGPIOModule.OEMGPIOModule"},
+                        {"Name", "GPIO Get"},
+                        {"Describe", "Use PATCH { CHIP:[number], NUMBER:[number] } to get register"},
+                    };
+                    asyncResp->res.end();
+                    return;
+                }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/GPIOGet")
+        .privileges(redfish::privileges::patchGPIOGet)
+        .methods(boost::beast::http::verb::patch)(
+            [](const crow::Request& req, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    std::optional<uint8_t> chip;
+                    std::optional<uint8_t> number;
+                    if (!json_util::readJson(req, asyncResp->res, "CHIP", chip, "NUMBER", number))
+                    {
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::string chip_set;
+                    std::string number_set;
+                    if (chip)
+                    {
+                        // Supported range [0-5]
+                        if (*chip > 5)
+                        {
+                            messages::queryParameterOutOfRange(
+                                asyncResp->res, std::to_string(*chip),
+                                "chip", "[0-5]");
+                        }
+                        else
+                        {
+                            chip_set = std::to_string(*chip);
+                        }
+                    }
+                    number_set = std::to_string(*number);
+                    std::string cmd("gpioget " + chip_set + " " + number_set + " > /mnt/GPIOGET");
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write ,error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::fprintf(stderr, "[ERROR AARON] \n");
+                    std::cout << "ERROR AARON cout " <<std::endl;
+                    std::ifstream fin ("/mnt/GPIOGET");
+                    std::string buffer;
+                    std::string byte;
+                    std::string GPIO_GET;
+                    int i = 0 ;
+                    while(getline(fin,buffer))
+                    {
+                        GPIO_GET=buffer;
+                        i++;
+                    }
+                    asyncResp->res.jsonValue["DATA"] = GPIO_GET;
+                    fin.close();
+                    if (system("rm -rf /mnt/GPIOGET") < 0){
+                        return;
+                    }
+                    asyncResp->res.end();
+                    return ;
+                }
+        );
+}
+}// namespace redfish
