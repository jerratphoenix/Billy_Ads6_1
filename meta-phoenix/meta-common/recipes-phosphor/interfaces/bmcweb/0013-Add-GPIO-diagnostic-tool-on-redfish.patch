@@ -215,6 +216,8 @@ class RedfishService
         requestRoutesOEMI2CDump(app);
         requestRoutesOEMI2CSet(app);
         requestRoutesOEMI2CGet(app);
+        requestRoutesOEMGPIOSet(app);
+        requestRoutesOEMGPIOGet(app);
