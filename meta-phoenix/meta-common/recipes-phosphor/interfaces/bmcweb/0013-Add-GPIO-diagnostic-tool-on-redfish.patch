diff --git a/redfish-core/include/registries/privilege_registry.hpp b/redfish-core/include/registries/privilege_registry.hpp
index c68f7c0..c05ef37 100755
--- a/redfish-core/include/registries/privilege_registry.hpp
+++ b/redfish-core/include/registries/privilege_registry.hpp
@@ -482,6 +482,22 @@ const static auto& putFanPWM = privilegeSetConfigureManager;
 const static auto& deleteFanPWM = privilegeSetConfigureManager;
 const static auto& postFanPWM = privilegeSetConfigureManager;
 
+//GPIOSet
+const static auto& getGPIOSet = privilegeSetLogin;
+const static auto& headGPIOSet = privilegeSetLogin;
+const static auto& patchGPIOSet = privilegeSetLogin;
