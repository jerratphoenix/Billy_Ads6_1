+inline void requestRoutesOEMI2CSet(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/I2CSet")
+        .privileges(redfish::privileges::getI2CSet)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request& /*req*/, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    asyncResp->res.jsonValue = {
+                        {"@odata.context", "/redfish/v1/$metadata#Manager"},
+                        {"@odata.id", "/redfish/v1/Managers/bmc/Oem/I2CSet"},
+                        {"@odata.type", "#OEMI2CModule.OEMI2CModule"},
+                        {"Name", "I2C Set"},
+                        {"Describe", "Use PATCH { BUS:[number], ADDR:[number], REG:[number], DATA:[number] } to set register"},
+                    };
+                    asyncResp->res.end();
+                    return;
+                }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/I2CSet")
+        .privileges(redfish::privileges::patchI2CSet)
+        .methods(boost::beast::http::verb::patch)(
+            [](const crow::Request& req, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    std::optional<uint8_t> bus;
+                    std::optional<uint8_t> addr;
+                    std::optional<uint8_t> reg;
+                    std::optional<uint8_t> data;
+                    if (!json_util::readJson(req, asyncResp->res, "BUS", bus, "ADDR", addr, "REG", reg, "DATA", data))
+                    {
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::string bus_set;
+                    std::string addr_set;
+                    std::string reg_set;
+                    std::string data_set;
+                    if (bus)
+                    {
+                        // Supported range [0-17]
+                        if (*bus > 17)
+                        {
+                            messages::queryParameterOutOfRange(
+                                asyncResp->res, std::to_string(*bus),
+                                "bus", "[0-17]");
+                        }
+                        else
+                        {
+                            bus_set = std::to_string(*bus);
+                        }
+                    }
+                    if (addr)
+                    {
+                        // Supported range [0-128]
+                        if (*addr > 128)
+                        {
+                            messages::queryParameterOutOfRange(
+                                asyncResp->res, std::to_string(*addr),
+                                "addr", "[0-128]");
+                        }
+                        else
+                        {
+                            addr_set = std::to_string(*addr);
+                        }
+                    }
+                    reg_set = std::to_string(*reg);
+                    data_set = std::to_string(*data);
+                    std::string cmd("i2cset -f -y " + bus_set + " " + addr_set + " " + reg_set + " " + data_set);
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write ,error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+                    asyncResp->res.end();
+                    return ;
+                }
+        );
+}
