+inline void requestRoutesOEMI2CDetect(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/I2CDetect/")
+        .privileges(redfish::privileges::getI2CDetect)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    asyncResp->res.jsonValue = {
+                        {"@odata.context", "/redfish/v1/$metadata#Manager"},
+                        {"@odata.id", "/redfish/v1/Managers/bmc/Oem/I2CDetect"},
+                        {"@odata.type", "#OEMI2CModule.OEMI2CModule"},
+                        {"Name", "I2C Detect"},
+                        {"Describe", "Use PATCH { BUS:[number] } to get devices for each BUS"},
+                    };
+
+                    std::string cmd("i2cdetect -l > /mnt/DETECTL");
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::ifstream fin ("/mnt/DETECTL");
+                    std::string buffer;
+                    std::string final_buffer;
+                    int i = 0;
+                    std::string I2C_BUS_SHOW[30];
+                    while(getline(fin,buffer))
+                    {
+                        final_buffer = final_buffer.assign(buffer,0,40);//limet 40
+                        final_buffer = final_buffer.replace(final_buffer.find("i2c "),5," "); //clear excess strings
+                        final_buffer = final_buffer.replace(final_buffer.find("\t"),1," "); //clear first tab space
+                        I2C_BUS_SHOW[i] = final_buffer.replace(final_buffer.find("\t"),1," "); //clear the second tab space
+                        i++;
+                    }
+
+                    asyncResp->res.jsonValue["I2C BUS Support list"] = I2C_BUS_SHOW;
+                    fin.close();
+                    if (system("rm -rf /mnt/DETECTL") < 0){
+                        return;
+                    }
+                    asyncResp->res.end();
+                    return;
+                }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/I2CDetect/")
+        .privileges(redfish::privileges::patchI2CDetect)
+        .methods(boost::beast::http::verb::patch)(
+            [](const crow::Request& req, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    std::optional<uint8_t> bus;
+                    if (!json_util::readJson(req, asyncResp->res, "BUS", bus))
+                    {
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::string bus_set;
+                    if (bus)
+                    {
+                        // Supported range [0-17]
+                        if (*bus > 17)
+                        {
+                            messages::queryParameterOutOfRange(
+                                asyncResp->res, std::to_string(*bus),
+                                "bus", "[0-17]");
+                        }
+                        else
+                        {
+                            bus_set = std::to_string(*bus);
+                        }
+                    }
+                    std::string cmd("i2cdetect -y " + bus_set + " > /mnt/DETECT");
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write ,error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::ifstream fin ("/mnt/DETECT");
+                    std::string buffer;
+
+                    std::string I2C_ADDR[9];
+                    int i = 0 ;
+                    while(getline(fin,buffer))
+                    {
+                        I2C_ADDR[i]=buffer;
+                        i++;
+                    }
+                    asyncResp->res.jsonValue["DATA"] = {I2C_ADDR[0],I2C_ADDR[1],I2C_ADDR[2],I2C_ADDR[3],I2C_ADDR[4],I2C_ADDR[5],I2C_ADDR[6],I2C_ADDR[7],I2C_ADDR[8]};            
+                    fin.close();
+                    if (system("rm -rf /mnt/DETECT") < 0){
+                        return;
+                    }
+                    asyncResp->res.end();
+                    return ;
+                }
+        );
+}
