+                    {
+                        I2C_DUMP[i]=buffer;
+                        i++;
+                    }
+                    asyncResp->res.jsonValue["DATA"] = {I2C_DUMP[0],I2C_DUMP[1],I2C_DUMP[2],I2C_DUMP[3],I2C_DUMP[4],I2C_DUMP[5],I2C_DUMP[6],I2C_DUMP[7],I2C_DUMP[8],I2C_DUMP[9],I2C_DUMP[10],I2C_DUMP[11],I2C_DUMP[12],I2C_DUMP[13],I2C_DUMP[14],I2C_DUMP[15],I2C_DUMP[16]};
+                    fin.close();
+                    if (system("rm -rf /mnt/DUMP") < 0){
+                        return;
+                    }
+                    asyncResp->res.end();
+                    return ;
+                }
+        );
