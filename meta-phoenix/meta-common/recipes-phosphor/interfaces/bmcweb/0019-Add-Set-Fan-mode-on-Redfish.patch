+
+inline void requsetRoutesOEMFanSetMode(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/FanModeSet")
+        .privileges(redfish::privileges::getFanSetMode)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */,
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    asyncResp->res.jsonValue = {
+                        //{"@Redfish.Copyright", "Copyright 2021 Distributed Management Task Force, Inc. (DMTF). All rights reserved."},
+                        {"@odata.context", "/redfish/v1/$metadata#Manager"},
+                        {"@odata.id", "/redfish/v1/Managers/bmc/Oem/FanModeSet"},
+                        {"@odata.type", "#OEMFanModeModule.OEMFanModeModule"},
+                        {"Name", "Fan Mode Set"},
+                        {"Describe", "Use PATCH { MODE:[number] } to set mode, 0 = Automatic mode, 1 = Manual mode, 2 = Full mode, 3 = Quite mode."},
+                    };
+                    asyncResp->res.end();
+                    return;
+                }
+        );
+
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/FanModeSet")
+        .privileges(redfish::privileges::patchFanSetMode)
+        .methods(boost::beast::http::verb::patch)(
+            [](const crow::Request& req, 
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    std::optional<uint8_t> number;
+                    if (!json_util::readJson(req, asyncResp->res, "MODE", number))
+                    {
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::string number_set;
+                    if (number)
+                    {
+                        // Supported range [0-3]
+                        if (*number > 3)
+                        {
+                            messages::queryParameterOutOfRange(
+                                asyncResp->res, std::to_string(*number),
+                                "chip", "[0-3]");
+                                asyncResp->res.end();
+                                return ;
+                        }
+                        else
+                        {
+                            number_set = std::to_string(*number);
+                        }
+                    }
+                    std::string cmd("ipmitool raw 0x2E 0x04 0xCF 0xC2 0x00 0x01 0x00 0x" + number_set);
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write ,error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+                    asyncResp->res.end();
+                    return ;
+                }
+        );
+
+}
+
+inline void requsetRoutesOEMFanGetMode(App& app)
+{
+    BMCWEB_ROUTE(app, "/redfish/v1/Managers/bmc/Oem/FanModeGet")
+        .privileges(redfish::privileges::getFanGetMode)
+        .methods(boost::beast::http::verb::get)(
+            [](const crow::Request&/* req */,
+                const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)-> void{
+                    asyncResp->res.jsonValue = {
+                        {"@odata.context", "/redfish/v1/$metadata#Manager"},
+                        {"@odata.id", "/redfish/v1/Managers/bmc/Oem/FanModeGet"},
+                        {"@odata.type", "#OEMFanModeModule.OEMFanModeModule"},
+                        {"Name", "Fan Mode Get"},
+                        {"Describe", "Fan mode 0 = Automatic mode, 1 = Manual mode, 2 = Full mode, 3 = Quite mode"},
+                    };
+                    std::string cmd("ipmitool raw 0x2E 0x04 0xCF 0xC2 0x00 0x00 0x00 > /mnt/FANMODGET");
+                    int ret = system(cmd.c_str());
+                    if (ret < 0)
+                    {
+                        std::cout << "failed to write ,error = " << strerror(-ret) << std::endl;
+                        messages::internalError(asyncResp->res);
+                        asyncResp->res.end();
+                        return;
+                    }
+                    std::ifstream fin ("/mnt/FANMODGET");
+                    std::string cmdline;
+                    std::string final_buffer;
+                    getline(fin, cmdline);
+                    final_buffer = final_buffer.assign(cmdline,11,1);//start 11 limet 1
+                    asyncResp->res.jsonValue["MODE"] = final_buffer;
+                    fin.close();
+                    asyncResp->res.end();
+                    return;
+                }
+        );
+}
