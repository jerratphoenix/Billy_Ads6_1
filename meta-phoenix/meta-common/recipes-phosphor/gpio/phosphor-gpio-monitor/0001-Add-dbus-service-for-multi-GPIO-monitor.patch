         if (line == NULL)
@@ -144,9 +245,10 @@ int main(int argc, char** argv)
         /* Get event to be monitored, if it is not defined then
          * Both rising falling edge will be monitored.
          */
+        std::string eventStr;
         if (obj.find("EventMon") != obj.end())
