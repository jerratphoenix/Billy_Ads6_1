@@ -62,11 +78,28 @@ void GpioMonitor::gpioEventHandler()
 
     std::string logMessage =
         gpioLineMsg + (gpioLineEvent.event_type == GPIOD_LINE_EVENT_RISING_EDGE
-                           ? " Asserted"
-                           : " Deasserted");
+                           ? " Rising Edge Triggered"
+                           : " Falling Edge Triggered");
 
     log<level::INFO>(logMessage.c_str());
 
+    /* sync statuses to dbus */
+    for (index = 0; index < g_gpioCount; index++) {
+        if (gpio_table[index].fd == gpioEventDescriptor.native_handle()) {
