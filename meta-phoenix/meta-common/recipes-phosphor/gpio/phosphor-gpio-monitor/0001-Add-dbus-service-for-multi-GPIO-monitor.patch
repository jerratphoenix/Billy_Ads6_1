diff --git a/gpioMon.hpp b/gpioMon.hpp
index b07bb40..8a5bbe8 100644
--- a/gpioMon.hpp
+++ b/gpioMon.hpp
@@ -4,6 +4,43 @@
 
 #include <boost/asio/io_service.hpp>
 #include <boost/asio/posix/stream_descriptor.hpp>
+#include <boost/algorithm/string.hpp>
+#include <sdbusplus/asio/connection.hpp>
+#include <sdbusplus/asio/object_server.hpp>
+#include <sdbusplus/server.hpp>
+
+#define MAX_GPIO_COUNT 512
+inline int32_t g_gpioCount = 0;
+
+/* Multi GPIO dbus service */
+constexpr auto MULTI_GPIO_SERVICE = "xyz.openbmc_project.MultiGpioMonitor";
+constexpr auto MULTI_GPIO_OBJPATH_PREFIX = "/xyz/openbmc_project/MultiGpioMonitor/";
+constexpr auto MULTI_GPIO_INTERFACE = "xyz.openbmc_project.GpioMonitor";
+
+struct gpio_var_t {
+    std::shared_ptr<sdbusplus::asio::dbus_interface> gpio_mon_intf;
+
+    int fd;
+    uint8_t value;
+    uint32_t offset;
+    std::string name;
+    std::string obj_path;
+    std::string direction;
+    std::string trigger_mode;
+
+    // constructor
+    gpio_var_t () {
+        fd = 0;
+        value = 0;
+        offset = 0;
+        name = "";
+        obj_path = "";
+        direction = "";
+        trigger_mode = "";
+    }
+};
+
+inline gpio_var_t gpio_table[MAX_GPIO_COUNT];
 
 namespace phosphor
 {
diff --git a/gpioMonMain.cpp b/gpioMonMain.cpp
index 4b8b052..8f4c886 100644
--- a/gpioMonMain.cpp
+++ b/gpioMonMain.cpp
@@ -21,9 +21,100 @@
 #include <fstream>
 #include <nlohmann/json.hpp>
 #include <phosphor-logging/log.hpp>
+#include <sdbusplus/asio/connection.hpp>
+#include <sdbusplus/asio/object_server.hpp>
+#include <sdbusplus/server.hpp>
+#include <boost/algorithm/string/replace.hpp>
+#include <boost/asio.hpp>
 
 using namespace phosphor::logging;
 
+
+/**
+ * @brief    Initial all GPIO information
+ *
+ * @param    index        GPIO index
+ * @param    gpioName     GPIO name
+ * @param    gpioLine     GPIO line point
+ * @param    triggerMode  GPIO trigger mode: FALLING, RISING, BOTH
+ *
+ */
+void initial_gpio_capability_info(int index, std::string gpioName, gpiod_line* gpioLine, std::string triggerMode) {
+    std::string gpioName_nospace;
+    std::string logMsg = "Initial GPIO Capabilities: index " + std::to_string(g_gpioCount);
+    log<level::INFO>(logMsg.c_str());
+
+    /* the dbus object path should not include spaces, replace the char of " " by "_" */
+    gpioName_nospace.assign(gpioName.c_str(), strlen(gpioName.c_str()));
+    gpioName_nospace = boost::replace_all_copy(gpioName_nospace, " ", "_");
+    gpio_table[index].name += gpioName_nospace;
+
+    /* set object path with GPIO name */
+    gpio_table[index].obj_path = MULTI_GPIO_OBJPATH_PREFIX;
+    gpio_table[index].obj_path += gpioName_nospace;
+
+    /* get the current GPIO value and set it into the table */
+    gpio_table[index].value = gpiod_line_get_value(gpioLine);
+
+    /* get the GPIO offset and set it into the table */
+    gpio_table[index].offset = gpiod_line_offset(gpioLine);
+
+    /* get the current GPIO direction and set it into the table */
+    gpio_table[index].direction = (gpiod_line_direction(gpioLine) == GPIOD_LINE_DIRECTION_INPUT
+                                ? "input" : "output");
+
+    /* set the trigger mode */
+    gpio_table[index].trigger_mode = triggerMode + "-EDGE";
+}
+
+/**
+ * @brief    Initial multi GPIO dbus
+ *
+ */
+void multi_gpio_dbus_service(void) {
+    boost::asio::io_context io;
+    auto conn = std::make_shared<sdbusplus::asio::connection>(io);
+
+    /* Init Service and Object */
+    std::string logMsg = "Register Multi GPIO Dbus Service";
+    log<level::INFO>(logMsg.c_str());
+
+    conn->request_name(MULTI_GPIO_SERVICE);
+    auto server = sdbusplus::asio::object_server(conn);
+
+    for (int index = 0; index < g_gpioCount; index++) {
+        if (gpio_table[index].obj_path.length() == 0) {
+            continue;
+        }
+
+        logMsg = "Object Path: " + gpio_table[index].obj_path;
+        log<level::INFO>(logMsg.c_str());
+
+        gpio_table[index].gpio_mon_intf = server.add_interface(
+                                            gpio_table[index].obj_path,
+                                            MULTI_GPIO_INTERFACE);
+        gpio_table[index].gpio_mon_intf->register_property("Name",
+                (std::string)gpio_table[index].name,
+                sdbusplus::asio::PropertyPermission::readOnly);
+        gpio_table[index].gpio_mon_intf->register_property("Value",
+                (uint8_t)gpio_table[index].value,
+                sdbusplus::asio::PropertyPermission::readWrite);
+        gpio_table[index].gpio_mon_intf->register_property("Offset",
+                (uint32_t)gpio_table[index].offset,
+                sdbusplus::asio::PropertyPermission::readOnly);
+        gpio_table[index].gpio_mon_intf->register_property("Direction",
+                (std::string)gpio_table[index].direction,
+                sdbusplus::asio::PropertyPermission::readWrite);
+        gpio_table[index].gpio_mon_intf->register_property("TriggerMode",
+                (std::string)gpio_table[index].trigger_mode,
+                sdbusplus::asio::PropertyPermission::readWrite);
+
+        gpio_table[index].gpio_mon_intf->initialize();
+    }
+
+    io.run();
+}
+
 namespace phosphor
 {
 namespace gpio
