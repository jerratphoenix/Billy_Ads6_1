From da2bf6d7c2f84238ac1acb2fa28813cf264c77b4 Mon Sep 17 00:00:00 2001
From: Chris Yeh <chris_yeh@phoenix.com>
Date: Thu, 16 Dec 2021 11:28:47 +0800
Subject: [PATCH] Fix Post code dequeue memory leak

The patch from ServerGold
---
 inc/post_code.hpp |  8 +++++---
 src/main.cpp      | 19 +++++++++++++++++--
 src/post_code.cpp |  1 +
 3 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/inc/post_code.hpp b/inc/post_code.hpp
index 08b1cc5..a0fa569 100644
--- a/inc/post_code.hpp
+++ b/inc/post_code.hpp
@@ -32,6 +32,7 @@
 #include <xyz/openbmc_project/Common/error.hpp>
 #include <xyz/openbmc_project/State/Boot/PostCode/server.hpp>
 #include <xyz/openbmc_project/State/Host/server.hpp>
+#include <sdbusplus/timer.hpp>
 
 const static constexpr char *CurrentBootCycleCountName =
     "CurrentBootCycleCount";
@@ -91,8 +92,8 @@ struct PostCode : sdbusplus::server::object_t<post_code, delete_all>
     PostCodeDataHolder *postcodeDataHolderObj =
         postcodeDataHolderObj->getInstance();
 
-    PostCode(sdbusplus::bus::bus &bus, const char *path, EventPtr &event) :
-        sdbusplus::server::object_t<post_code, delete_all>(bus, path), bus(bus),
+    PostCode(sdbusplus::bus::bus &bus, const char *path, EventPtr & event, phosphor::Timer &timer) :
+        sdbusplus::server::object_t<post_code, delete_all>(bus, path), bus(bus), serializeTimer(timer),
         propertiesChangedSignalRaw(
             bus,
             sdbusplus::bus::match::rules::type::signal() +
@@ -185,6 +186,7 @@ struct PostCode : sdbusplus::server::object_t<post_code, delete_all>
     std::map<uint64_t, postcode_t>
         getPostCodesWithTimeStamp(uint16_t index) override;
     void deleteAll() override;
+    fs::path serialize(const std::string &path);
 
   private:
     void incrBootCycle();
@@ -201,8 +203,8 @@ struct PostCode : sdbusplus::server::object_t<post_code, delete_all>
     void savePostCodes(postcode_t code);
     sdbusplus::bus::match_t propertiesChangedSignalRaw;
     sdbusplus::bus::match_t propertiesChangedSignalCurrentHostState;
-    fs::path serialize(const std::string &path);
     bool deserialize(const fs::path &path, uint16_t &index);
     bool deserializePostCodes(const fs::path &path,
                               std::map<uint64_t, postcode_t> &codes);
+    phosphor::Timer &serializeTimer;
 };
diff --git a/src/main.cpp b/src/main.cpp
index 2cdb490..8dbbb93 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -15,6 +15,20 @@
 */
 #include "post_code.hpp"
 
+static PostCode* sg_pPostCode = nullptr;
+
+void SerializeTimerCallback()
+{
+    //std::cerr << "serialize timer expired, serializing..." << std::endl;
+    if( sg_pPostCode != nullptr )
+    {
+        PostCodeDataHolder* postcodeDataHolderObj =
+        postcodeDataHolderObj->getInstance();
+        sg_pPostCode->serialize(fs::path(postcodeDataHolderObj->PostCodeListPathPrefix
+                                    +  std::to_string(postcodeDataHolderObj->node)));
+    }
+}
+
 #include <getopt.h>
 
 int main(int argc, char* argv[])
@@ -55,7 +69,6 @@ int main(int argc, char* argv[])
         return ret;
     }
     EventPtr eventP{event};
-    event = nullptr;
 
     sdbusplus::bus::bus bus = sdbusplus::bus::new_default();
     sdbusplus::server::manager_t m{bus, DBUS_OBJECT_NAME};
@@ -64,7 +77,9 @@ int main(int argc, char* argv[])
 
     bus.request_name(intfName.c_str());
 
-    PostCode postCode{bus, DBUS_OBJECT_NAME, eventP};
+    phosphor::Timer serializeTimer(event, SerializeTimerCallback);
+    PostCode postCode{bus, DBUS_OBJECT_NAME, eventP, serializeTimer};
+    sg_pPostCode = &postCode;
 
     try
     {
diff --git a/src/post_code.cpp b/src/post_code.cpp
index c62c389..2698e0d 100644
--- a/src/post_code.cpp
+++ b/src/post_code.cpp
@@ -96,6 +96,7 @@ void PostCode::savePostCodes(postcode_t code)
 
     postCodes.insert(std::make_pair(tsUS, code));
     serialize(fs::path(strPostCodeListPath));
+    serializeTimer.start(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::seconds(2)));
 
 #ifdef ENABLE_BIOS_POST_CODE_LOG
     std::ostringstream hexCode;
-- 
2.17.1

