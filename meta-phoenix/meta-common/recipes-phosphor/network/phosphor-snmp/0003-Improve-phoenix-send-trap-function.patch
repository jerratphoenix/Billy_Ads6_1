         seqNum(seqN), sensorType(type),
         eventType(eventType), eventOffset(eventOffset), guid(guid),
         timeStamp(timeStamp), utc(utc), trapSourceType(trapSourceType),
@@ -290,7 +295,7 @@ class PhoenixErrorNotification : public Notification
         sensorDevice(sensorDevice), sensorNumber(sensorNumber), entity(entity),
         entityInstance(entityInstance), eventData1(eventData1), eventData2(eventData2),
         eventData3(eventData3), languageCode(languageCode), mftID(mftID), systemID(systemID),
-        msg(msg), destTest(dest)
