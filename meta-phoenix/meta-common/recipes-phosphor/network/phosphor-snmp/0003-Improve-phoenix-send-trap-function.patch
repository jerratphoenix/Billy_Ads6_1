                           uint32_t eventSeverity, uint32_t sensorDevice, uint32_t sensorNumber,
                           uint32_t entity, uint32_t entityInstance, uint32_t eventData1,
                           uint32_t eventData2, uint32_t eventData3, uint32_t languageCode,
