     {
     }
   protected:
@@ -444,13 +449,6 @@ class PhoenixErrorNotification : public Notification
         tuple = std::tuple<OID, OID_LEN, Type, Value>(id, idLen, type,
                                                       systemID);
 
-        objectList.emplace_back(std::move(tuple));
-
