-        type = getASNType<decltype(msg)>();
-        tuple = std::tuple<OID, OID_LEN, Type, Value>(id, idLen, type,
-                                                      msg);
-
         objectList.emplace_back(std::move(tuple));
         return objectList;
     }
@@ -459,6 +457,10 @@ class PhoenixErrorNotification : public Notification
     {
         return destTest;
     }
+    void setFlag(bool status) override
+    {
+        *flag = status;
+    }
     friend class TestErrorNotification;
 };
