From 4315ba2cbb2f4f490cffaa833f877b051439437e Mon Sep 17 00:00:00 2001
From: Amy Chang <Amy_Chang@phoenix.com>
Date: Mon, 6 Feb 2023 03:19:18 +0000
Subject: [PATCH] Set IP address solid for eth0 only

---
 src/ethernet_interface.cpp | 29 +++++++++++++++++++----------
 src/network_config.cpp     |  2 +-
 2 files changed, 20 insertions(+), 11 deletions(-)

diff --git a/src/ethernet_interface.cpp b/src/ethernet_interface.cpp
index ac2793b..a4e7cb4 100644
--- a/src/ethernet_interface.cpp
+++ b/src/ethernet_interface.cpp
@@ -87,9 +87,14 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
     auto intfName = objPath.substr(objPath.rfind("/") + 1);
     std::replace(intfName.begin(), intfName.end(), '_', '.');
     interfaceName(intfName);
-    // Disable DHCP
-    EthernetInterfaceIntf::dhcpEnabled(EthernetInterface::DHCPConf::none);
-    EthernetInterfaceIntf::ipv6AcceptRA(false);
+    if (intfName == "eth0") {
+        // Disable DHCP
+        EthernetInterfaceIntf::dhcpEnabled(EthernetInterface::DHCPConf::none);
+        EthernetInterfaceIntf::ipv6AcceptRA(false);
+    } else {
+        EthernetInterfaceIntf::dhcpEnabled(dhcpEnabled);
+        EthernetInterfaceIntf::ipv6AcceptRA(getIPv6AcceptRAFromConf());
+    }
     EthernetInterfaceIntf::nicEnabled(enabled ? *enabled : queryNicEnabled());
     const auto& gatewayList = manager.getRouteTable().getDefaultGateway();
     const auto& gateway6List = manager.getRouteTable().getDefaultGateway6();
@@ -114,7 +119,9 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
         }
     }
 
-    defaultGateway = "192.168.60.1";
+    if (intfName == "eth0") {
+        defaultGateway = "192.168.60.1";
+    }
     EthernetInterfaceIntf::defaultGateway(defaultGateway);
     EthernetInterfaceIntf::defaultGateway6(defaultGateway6);
     // Don't get the mac address from the system as the mac address
@@ -125,12 +132,14 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
     }
     EthernetInterfaceIntf::ntpServers(getNTPServersFromConf());
 
-    /* Set default network setting to Static
-     * ipaddressipaddress: 192.168.60.150
-     * prefixLength: 24
-     * gateway: 192.168.60.1
-     */
-    EthernetInterface::ip(IP::Protocol::IPv4, "192.168.60.150", 24, "192.168.60.1");
+    if (intfName == "eth0") {
+        /* Set default network setting to Static
+         * ipaddressipaddress: 192.168.60.150
+         * prefixLength: 24
+         * gateway: 192.168.60.1
+         */
+        EthernetInterface::ip(IP::Protocol::IPv4, "192.168.60.150", 24, "192.168.60.1");
+    }
 
     EthernetInterfaceIntf::linkUp(linkUp());
     EthernetInterfaceIntf::mtu(mtu());
diff --git a/src/network_config.cpp b/src/network_config.cpp
index 4c63e38..e996330 100644
--- a/src/network_config.cpp
+++ b/src/network_config.cpp
@@ -55,7 +55,7 @@ void writeStaticDefault(const std::string& filename, const std::string& interfac
     if(interface == "eth0")
     {
         filestream << "[Address]\nAddress=192.168.60.150/24\n"
-		      "[Route]\nGateway=192.168.60.1\n";
+                      "[Route]\nGateway=192.168.60.1\n";
     }
     filestream.close();
 }
-- 
