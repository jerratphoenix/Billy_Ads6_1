From 0511e580a2e7bf3163e313fdb91272f00cd88ecd Mon Sep 17 00:00:00 2001
From: Amy Chang <Amy_Chang@phoenix.com>
Date: Fri, 3 Feb 2023 07:42:23 +0000
Subject: [PATCH] Add two eth0 IPv4 IP addresses

---
 src/ethernet_interface.cpp | 2 ++
 src/network_config.cpp     | 4 +++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/ethernet_interface.cpp b/src/ethernet_interface.cpp
index a4e7cb4..6357009 100644
--- a/src/ethernet_interface.cpp
+++ b/src/ethernet_interface.cpp
@@ -139,6 +139,8 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
          * gateway: 192.168.60.1
          */
         EthernetInterface::ip(IP::Protocol::IPv4, "192.168.60.150", 24, "192.168.60.1");
+        // As temporary for the factory setup network switch
+        EthernetInterface::ip(IP::Protocol::IPv4, "192.168.10.150", 24, "192.168.10.1");
     }
 
     EthernetInterfaceIntf::linkUp(linkUp());
diff --git a/src/network_config.cpp b/src/network_config.cpp
index e996330..db3031f 100644
--- a/src/network_config.cpp
+++ b/src/network_config.cpp
@@ -55,7 +55,9 @@ void writeStaticDefault(const std::string& filename, const std::string& interfac
     if(interface == "eth0")
     {
         filestream << "[Address]\nAddress=192.168.60.150/24\n"
-                      "[Route]\nGateway=192.168.60.1\n";
+                      "[Address]\nAddress=192.168.10.150/24\n"
+                      "[Route]\nGateway=192.168.60.1\n"
+                      "[Route]\nGateway=192.168.10.1\n";
     }
     filestream.close();
 }
-- 
