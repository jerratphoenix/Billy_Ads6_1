From 40e6942d6ebcd8be68128ee43139f13f6fc5a8e4 Mon Sep 17 00:00:00 2001
From: Amy Chang <Amy_Chang@phoenix.com>
Date: Thu, 22 Dec 2022 05:11:11 +0000
Subject: [PATCH] Set the static IP for eth0

Default select the hardcode Static setting
---
 meson.build                |  6 ------
 src/ethernet_interface.cpp | 13 +++++++++++--
 src/network_config.cpp     | 18 ++++++++++++++++++
 src/network_config.hpp     |  2 ++
 src/network_manager.cpp    |  3 ++-
 5 files changed, 33 insertions(+), 9 deletions(-)

diff --git a/meson.build b/meson.build
index 5112562..ae6f4f3 100644
--- a/meson.build
+++ b/meson.build
@@ -13,12 +13,6 @@ default_busname = 'xyz.openbmc_project.Network'
 conf_data = configuration_data()
 conf_data.set_quoted('DEFAULT_BUSNAME', default_busname)
 conf_data.set('HAVE_UBOOT_ENV', get_option('uboot-env'))
-conf_data.set(
-  'LINK_LOCAL_AUTOCONFIGURATION',
-  get_option('default-link-local-autoconf'))
-conf_data.set(
-  'ENABLE_IPV6_ACCEPT_RA',
-  get_option('default-ipv6-accept-ra'))
 conf_data.set('NIC_SUPPORTS_ETHTOOL', get_option('nic-ethtool'))
 conf_data.set('SYNC_MAC_FROM_INVENTORY', get_option('sync-mac'))
 
diff --git a/src/ethernet_interface.cpp b/src/ethernet_interface.cpp
index 3cca478..d27ef56 100644
--- a/src/ethernet_interface.cpp
+++ b/src/ethernet_interface.cpp
@@ -87,8 +87,9 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
     auto intfName = objPath.substr(objPath.rfind("/") + 1);
     std::replace(intfName.begin(), intfName.end(), '_', '.');
     interfaceName(intfName);
-    EthernetInterfaceIntf::dhcpEnabled(dhcpEnabled);
-    EthernetInterfaceIntf::ipv6AcceptRA(getIPv6AcceptRAFromConf());
+    // Disable DHCP
+    EthernetInterfaceIntf::dhcpEnabled(EthernetInterface::DHCPConf::none);
+    EthernetInterfaceIntf::ipv6AcceptRA(false);
     EthernetInterfaceIntf::nicEnabled(enabled ? *enabled : queryNicEnabled());
     const auto& gatewayList = manager.getRouteTable().getDefaultGateway();
     const auto& gateway6List = manager.getRouteTable().getDefaultGateway6();
@@ -113,6 +114,7 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
         }
     }
 
+    defaultGateway = "192.168.10.1";
     EthernetInterfaceIntf::defaultGateway(defaultGateway);
     EthernetInterfaceIntf::defaultGateway6(defaultGateway6);
     // Don't get the mac address from the system as the mac address
@@ -123,6 +125,13 @@ EthernetInterface::EthernetInterface(sdbusplus::bus::bus& bus,
     }
     EthernetInterfaceIntf::ntpServers(getNTPServersFromConf());
 
+    /* Set default network setting to Static
+     * ipaddressipaddress: 192.168.10.150
+     * prefixLength: 24
+     * gateway: 192.168.10.1
+     */
+    EthernetInterface::ip(IP::Protocol::IPv4, "192.168.10.150", 24, "192.168.10.1");
+
     EthernetInterfaceIntf::linkUp(linkUp());
     EthernetInterfaceIntf::mtu(mtu());
 
diff --git a/src/network_config.cpp b/src/network_config.cpp
index 94c8eae..5fb1ef0 100644
--- a/src/network_config.cpp
+++ b/src/network_config.cpp
@@ -41,6 +41,24 @@ void writeDHCPDefault(const std::string& filename, const std::string& interface)
                 "[DHCP]\nClientIdentifier=mac\n";
     filestream.close();
 }
+
+void writeStaticDefault(const std::string& filename, const std::string& interface)
+{
+    std::ofstream filestream;
+
+    filestream.open(filename);
+
+    filestream << "[Match]\nName=" << interface <<
+                "\n[Network]\nDHCP=false\n"
+                "LinkLocalAddressing=no\n"
+                "IPv6AcceptRA=false\n";
+    if(interface == "eth0")
+    {
+        filestream << "[Address]\nAddress=192.168.10.150/24\n"
+		      "[Route]\nGateway=192.168.10.1\n";
+    }
+    filestream.close();
+}
 } // namespace bmc
 
 } // namespace network
diff --git a/src/network_config.hpp b/src/network_config.hpp
index 7260ca2..fc5c457 100644
--- a/src/network_config.hpp
+++ b/src/network_config.hpp
@@ -9,6 +9,8 @@ namespace bmc
 {
 void writeDHCPDefault(const std::string& filename,
                       const std::string& interface);
+void writeStaticDefault(const std::string& filename,
+                      const std::string& interface);
 }
 
 } // namespace network
diff --git a/src/network_manager.cpp b/src/network_manager.cpp
index 6417a13..e12a105 100644
--- a/src/network_manager.cpp
+++ b/src/network_manager.cpp
@@ -88,7 +88,8 @@ bool Manager::createDefaultNetworkFiles(bool force)
 
             if (force || !fs::is_regular_file(filePath.string()))
             {
-                bmc::writeDHCPDefault(filePath.string(), interface);
+                // Default select the hardcode Static setting for specific use
+                bmc::writeStaticDefault(filePath.string(), interface);
                 log<level::INFO>("Created the default network file.",
                                  entry("INTERFACE=%s", interface.c_str()));
                 isCreated = true;
-- 
2.17.1

