+
+inline int setGpioValue(const std::string& name, int value, const int polarity)
+{
+    gpiod::line line;
+
+    line = gpiod::find_line(name);
+
+    if (!line) {
+        std::cerr << "Error finding GPIO: " << name.c_str() << std::endl;
+        return -1;
+    }
+
+    try
+    {
+        line.request({"cpu-sensors",
+            gpiod::line_request::DIRECTION_OUTPUT,
+            polarity == gpiod::line::ACTIVE_HIGH
+                        ? 0
+                        : gpiod::line_request::FLAG_ACTIVE_LOW});
+    }
+    catch (std::system_error&) {
+        std::cerr << "Error requesting GPIO: " << name.c_str() << std::endl;
+        line.release();
+        return -1;
+    }
+
+    try
+    {
+        line.set_value(value);
+    }
+    catch (std::system_error& exc)
+    {
+        std::cerr << "Error setting GPIO " << name.c_str() << " value to " << std::to_string(value)  << std::endl;
+        line.release();
+        return -1;
+    }
+
+    line.release();
+
+    return 0;
+}
+
+inline void peciMuxSelection(std::string peciDevPath)
+{
+    static int devPrevIdx = 0;
+    int devCurrIdx = -1;
+
+    /* [PECI mapping table]
+        PECI_CPU_MUX_OE   |  PECI_A_SG1_MUX_OE  |  PECI_B_SG1_MUX_OE  |  BMC PECI Connects to
+        (GPIOX5_SPI2MISO) |  (GPIOX4_SPI2MOSI)  |  (GPIOX3_SPI2CK)    |
+      --------------------+---------------------+---------------------+------------------------------
+        1                 |  0                  |  0                  |  CPU PECI (bus 0, addr 0x30)
+      -----------------------------------------------------------------------------------------------
+        0                 |  1                  |  0                  |  SG1A PECI (bus 0, addr 0x32)
+      -----------------------------------------------------------------------------------------------
+        0                 |  0                  |  1                  |  SG1B PECI (unused)
+    */
+    if (peciDevPath.find("0-30") != std::string::npos) {
+        devCurrIdx = 0;  // CPU0
+    } else if (peciDevPath.find("0-32") != std::string::npos) {
+        devCurrIdx = 1;  // SG1_A
+    } else {
+        devCurrIdx = -1; // default
+    }
+
+    if (devCurrIdx != devPrevIdx) {
+        switch (devCurrIdx) {
+            case 0:
+                setGpioValue("PECI_CPU_MUX_OE", 1, gpiod::line::ACTIVE_HIGH);
+                setGpioValue("PECI_A_SG1_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                setGpioValue("PECI_B_SG1_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                break;
+            case 1:
+                setGpioValue("PECI_CPU_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                setGpioValue("PECI_A_SG1_MUX_OE", 1, gpiod::line::ACTIVE_HIGH);
+                setGpioValue("PECI_B_SG1_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                break;
+            default:
+                setGpioValue("PECI_CPU_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                setGpioValue("PECI_A_SG1_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                setGpioValue("PECI_B_SG1_MUX_OE", 0, gpiod::line::ACTIVE_HIGH);
+                break;
+        }
+        devPrevIdx = devCurrIdx;
+    }
+}
