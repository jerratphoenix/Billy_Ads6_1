[Unit]
Description=cpu vr state monitor

[Service]
Restart=on-failure
RestartSec=1
StartLimitInterval=30s
StartLimitBurst=2
ExecStartPre=/bin/cp /usr/bin/vr_controller.json /tmp/vr_controller.json
ExecStart=/usr/bin/vr-sensor-monitor
SyslogIdentifier=vr-sensor-monitor
Type=dbus
BusName=xyz.openbmc_project.PHX.VRSensor.Monitor

[Install]
WantedBy=multi-user.target
